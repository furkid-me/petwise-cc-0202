# Option 1: Local Docker (docker-compose up)
DATABASE_URL="postgresql://petwise:petwise123@localhost:5432/petwise?schema=public"

# Option 2: Supabase (https://supabase.com)
# 注意：Supabase 使用 PgBouncer，需要加上 pgbouncer=true
# DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Option 3: Neon (https://neon.tech)
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require"

# Option 4: Railway (https://railway.app)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].railway.app:5432/railway"

